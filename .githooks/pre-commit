#!/usr/bin/env bash
# Optional staged-file hygiene. Qualification uses scripts/check-rust-sles.py.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
git diff --cached --check
python3 - <<'PYHOOK'
import re, subprocess, sys
paths = subprocess.check_output(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"]).split(b"\0")
errors = []
for raw in filter(None, paths):
    name = raw.decode("utf-8")
    data = subprocess.check_output(["git", "show", ":" + name])
    if b"\0" in data or name.lower().endswith((".png", ".jpg", ".jpeg", ".gif", ".ico", ".pdf", ".bin", ".db")):
        continue
    if b"\r" in data:
        errors.append(name + ": CR line ending")
    if re.search(rb"^(?:<{7}|={7}|>{7})(?: |$)", data, re.M):
        errors.append(name + ": merge conflict marker")
    if len(data) > 1024 * 1024:
        errors.append(name + ": staged file exceeds 1 MiB; retain large raw evidence outside Git")
if errors:
    print("\n".join(errors), file=sys.stderr)
    sys.exit(1)
PYHOOK
