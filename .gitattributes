# Normalize line endings to LF for text files. CI (hygiene.yml) rejects committed
# CR line endings; the optional .githooks/pre-commit catches them earlier.
* text=auto eol=lf
poetry.lock text eol=lf
*.png binary
*.jpg binary
*.ico binary
*.pdf binary

# Schema fixtures are frozen SQLite databases, byte-exact by definition and by
# purpose: their whole value is being the file an *older* build produced. The
# rule at the top would rewrite any byte inside one that happened to look like
# a line ending, giving a database corrupt in a way no diff would show.
*.db binary

# Windows batch files need CRLF in the working tree; the index stays LF.
*.cmd text eol=crlf
