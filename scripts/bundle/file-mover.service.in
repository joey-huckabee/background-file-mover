# Candidate native Rust unit, not a qualified production deployment policy.
# Replace installation, user, group and config placeholders before installation.
[Unit]
Description=Background File Mover (Rust prototype)

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
ExecStart=@INSTALL_ROOT@/bin/file-mover @CONFIG_PATH@
# Unit-scoped signals only: global --stop here could stop a foreign owner.
KillMode=control-group
SendSIGKILL=no
# For the default 60-second mover budget. Set above your configured budget.
TimeoutStopSec=75
# Activation/retry remains explicit until the shipping policy is qualified.
Restart=no
CapabilityBoundingSet=
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=multi-user.target
